# Copy this file to .env and fill in one provider section.
# Never commit .env.

DZIENNICZEK_PROVIDER=eduvulcan
DZIENNICZEK_PROFILE=default

# eduVULCAN or Librus
DZIENNICZEK_USERNAME=
DZIENNICZEK_PASSWORD=
# Optional when the account belongs to exactly one tenant
DZIENNICZEK_TENANT=

# Dzienniczek VULCAN token login
# DZIENNICZEK_PROVIDER=vulcan
# DZIENNICZEK_TOKEN=
# DZIENNICZEK_PIN=
# DZIENNICZEK_SYMBOL=

# Manual eduVULCAN JWT login
# DZIENNICZEK_PROVIDER=jwt
# DZIENNICZEK_JWT=
# DZIENNICZEK_TENANT=
