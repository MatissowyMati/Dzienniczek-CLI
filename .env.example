# Skopiuj ten plik jako .env i uzupełnij sekcję jednego dostawcy.
# Nigdy nie zatwierdzaj pliku .env w Git.

DZIENNICZEK_PROVIDER=eduvulcan
DZIENNICZEK_PROFILE=default

# eduVULCAN lub Librus
DZIENNICZEK_USERNAME=
DZIENNICZEK_PASSWORD=
# Opcjonalne, gdy konto należy do dokładnie jednego tenanta
DZIENNICZEK_TENANT=

# Logowanie tokenem Dzienniczek VULCAN
# DZIENNICZEK_PROVIDER=vulcan
# DZIENNICZEK_TOKEN=
# DZIENNICZEK_PIN=
# DZIENNICZEK_SYMBOL=

# Ręczne logowanie JWT do eduVULCAN
# DZIENNICZEK_PROVIDER=jwt
# DZIENNICZEK_JWT=
# DZIENNICZEK_TENANT=
