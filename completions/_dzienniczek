#compdef dzienniczek

_dzienniczek() {
  local -a commands
  commands=(
    'login:zaloguj do VULCAN, eduVULCAN lub Librus'
    'logout:usuń profil lokalny'
    'profile:zarządzaj profilami'
    'account:zarządzaj kontami uczniów'
    'dashboard:pokaż pulpit ucznia'
    'grades:pokaż oceny, średnie lub podsumowania'
    'schedule:pokaż plan lekcji'
    'exams:pokaż sprawdziany'
    'homework:pokaż zadania domowe'
    'presence:pokaż frekwencję i statystyki'
    'messages:pokaż foldery wiadomości'
    'notes:pokaż uwagi'
    'announcements:pokaż ogłoszenia'
    'capabilities:pokaż maszynową listę możliwości'
    'doctor:sprawdź środowisko, konfigurację i gotowość logowania'
    'env:pokaż dostępność danych logowania bez ujawniania wartości'
    'mcp:uruchom lokalny serwer MCP przez stdio'
  )
  _describe 'polecenie' commands
}

_dzienniczek "$@"
